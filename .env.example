# ==============================================================================
# PayStat Environment Variables Configuration
# ==============================================================================

# Application
APP_ENV=development
APP_PORT=8001
APP_HOST=0.0.0.0

# ClickHouse Configuration
# Адрес для запуска с хоста; внутри docker-сети compose подставляет clickhouse:8123 сам
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DATABASE=analytics
CLICKHOUSE_USER=readonly_user
CLICKHOUSE_PASSWORD=readonly_secret

# LLM Providers Configuration
GROQ_API_KEY=your_groq_api_key_here
PRIMARY_MODEL=openai/gpt-oss-120b
FALLBACK_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant

# Agent Limits & Safety (PRD Section 5 & 6)
MAX_AGENT_ITERATIONS=3
MAX_QUERY_ROWS=1000
QUERY_TIMEOUT_SECONDS=10

# CORS Configuration (comma-separated origins)
# Prepared for future frontend applications (e.g. React/Vue on local ports)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

